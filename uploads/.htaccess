# Never execute scripts from the uploads folder
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|exe)$">
  Require all denied
</FilesMatch>
Options -Indexes
